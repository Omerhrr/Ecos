# ECOS environment (copy to .env and fill in)
# NOTE: .env is gitignored — never commit real keys.

# Database (SQLite for dev; the schema is Alembic-migration-owned)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# §31 AI Harness — DeepSeek live inference.
# PREFERRED: paste the key in Admin → AI Harness → "Add DeepSeek key".
# It is stored obfuscated in your own database (ai_provider_settings) and
# flips the harness live instantly — no restart, env var not needed.
# Alternatively (headless deployments), set it here:
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# The harness uses the DB-stored key first, then the env var.

# §39 Phase 3 outbound channels — leave unset for the dev-console provider.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=secret
# SMTP_FROM="Kara NG <notifications@example.com>"
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
